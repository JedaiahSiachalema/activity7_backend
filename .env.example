# Local PostgreSQL connection string. Never commit your real .env file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/study_support
# Comma-separated frontend origins. Leave blank during local API-only testing.
CLIENT_ORIGINS=http://localhost:8000
# Optional; hosting platforms provide PORT automatically.
PORT=3000
# Set to true for hosted PostgreSQL providers that require SSL.
DB_SSL=false
